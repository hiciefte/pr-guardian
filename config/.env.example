# PR Guardian Environment Variables
# Copy to config/.env and fill in your values

# GitHub Authentication (required)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, write:discussion
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic LLM API (required for comment parsing)
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing Method (optional, default: web-flow)
# Options: web-flow, gpg
SIGNING_METHOD=web-flow

# Redis Caching (optional, default: true)
# Set to false to disable semantic caching
REDIS_ENABLED=true

# Healthchecks.io Monitoring (optional)
# Create check at: https://healthchecks.io
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# LLM Configuration Overrides (optional)
# LLM_MODEL=claude-3-haiku-20240307
# LLM_MAX_TOKENS=500
# LLM_CONFIDENCE_THRESHOLD=0.80
